#!/usr/bin/env bash
# Blocks commits whose generated host artifacts or skill surface fail their checks.
# Checks an export of the index, so only what is being committed counts.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

fail() {
  echo "pre-commit: $1" >&2
  echo "fix: $2" >&2
  exit 1
}

command -v bun >/dev/null 2>&1 || fail "bun is not on PATH" "install bun, then retry the commit"
tmp="$(mktemp -d "${TMPDIR:-/tmp}/pre-commit-index.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT
git checkout-index --all --ignore-skip-worktree-bits --prefix="$tmp/"
cd "$tmp"
bun scripts/generate-hosts.ts --check ||
  fail "staged generated host artifacts are stale" "bun scripts/generate-hosts.ts && git add AGENTS.md claude/"
bash skills/evals/check-skill-surface.sh ||
  fail "skill surface check failed on the staged files" "fix the files reported above, stage them, then run bash skills/evals/check-skill-surface.sh"
