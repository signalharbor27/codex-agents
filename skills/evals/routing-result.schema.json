{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "primary_skill",
    "modifier_skills",
    "references",
    "actions",
    "first_action",
    "mutation",
    "question",
    "stop"
  ],
  "properties": {
    "primary_skill": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "modifier_skills": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "references": {
      "type": "array",
      "description": "Exact existing Markdown paths relative to the supplied skills root, beginning with the owning skill folder. Preserve filename case; omit a leading skills/ or absolute path prefix.",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.md$"
      }
    },
    "actions": {
      "type": "array",
      "description": "Role actions select source profiles: delegate-oracle-review and consult-oracle select oracle; delegate-fast-review selects fast_reviewer; delegate-command-verification selects verifier. delegate-oracle-review assigns substantive review to an independent non-author. delegate-standards-intent-simplification assigns those checks to independent reviewers within the requested scope. delegate-one-coupled-review groups coupled topics with one independent reviewer. delegate-independent-tracks assigns bounded material review tracks; dispatch-independent-tracks-in-parallel starts separable tracks together when capacity is available. use-built-in-review-agent applies the host-provided defect-review skill. keep-reviewers-nonrecursive prevents children from spawning agents or invoking the outer review gate. retain-main-review-ownership keeps orchestration, finding judgment, fixes, verification, and completion with the main agent, whose own inspection cannot supply review coverage. report-blocked-review-coverage reports unavailable independent coverage without claiming completion. keep-coupled-review-local means review performed by the main agent without independent reviewer coverage.",
      "items": {
        "type": "string",
        "enum": [
          "account-for-all-review-topics",
          "apply-post-implementation-review",
          "ask-exactly-one-question",
          "ask-dependency-frontier-round",
          "build-production-complete-slice",
          "build-red-capable-loop",
          "carry-unresolved-findings-forward",
          "cite-authoritative-sources",
          "confirm-final-review-coverage",
          "consult-oracle",
          "create-requested-plan-file",
          "delegate-command-verification",
          "delegate-fast-review",
          "delegate-independent-tracks",
          "delegate-one-coupled-review",
          "delegate-oracle-review",
          "delegate-standards-intent-simplification",
          "dispatch-independent-tracks-in-parallel",
          "do-not-change-branch-state",
          "do-not-invent-verification",
          "find-root-cause-before-fix",
          "honor-single-track-scope",
          "identify-claim-matched-proof",
          "inspect-before-editing",
          "inspect-before-recommending",
          "inspect-both-intents",
          "inspect-worktree-conventions",
          "keep-coupled-review-local",
          "keep-domain-artifacts-proposed",
          "keep-reviewers-nonrecursive",
          "keep-standards-and-intent-separate",
          "keep-task-read-only",
          "select-minimum-useful-reviewers",
          "load-only-present-pressure-references",
          "narrow-oversized-grill",
          "pin-review-scope",
          "preserve-stable-question-numbering",
          "preserve-effect-boundary",
          "read-final-diff",
          "record-review-snapshot",
          "recover-review-snapshot-or-full-scope",
          "report-worktree-location",
          "report-blocked-review-coverage",
          "recap-decisions-before-transition",
          "require-explicit-branch-integration-choice",
          "resolve-facts-before-asking",
          "retain-main-review-ownership",
          "review-combined-integration",
          "review-delta-since-last-snapshot",
          "review-entire-intended-diff",
          "separate-facts-decisions-and-open-questions",
          "separate-facts-inference-and-recommendations",
          "separate-findings-from-plan",
          "single-source-durable-map",
          "state-rust-specific-pressure",
          "state-workload-and-correctness-pressure",
          "stay-within-change-budget",
          "stop-before-implementation",
          "trace-each-material-intent-requirement",
          "trace-affected-contracts",
          "use-built-in-review-agent",
          "use-independent-test-oracle",
          "validate-skill-surface",
          "verify-before-completion",
          "verify-branch-state",
          "verify-feedback-against-code"
        ]
      }
    },
    "first_action": {
      "type": "string",
      "enum": [
        "build-failing-loop",
        "evaluate-feedback",
        "identify-proof",
        "inspect-current-state",
        "map-decisions",
        "map-workload",
        "pin-review-scope",
        "read-final-diff",
        "verify-branch-state",
        "answer-directly"
      ]
    },
    "mutation": {
      "type": "string",
      "enum": [
        "after-user-choice",
        "diagnostic-only",
        "none",
        "requested-plan-file",
        "requested-repo-writes",
        "requested-worktree"
      ]
    },
    "question": {
      "type": "string",
      "enum": [
        "dependency-frontier",
        "none",
        "one-at-a-time",
        "only-if-blocked",
        "required-before-unapproved-action"
      ]
    },
    "stop": {
      "type": "string",
      "enum": [
        "after-artifact",
        "after-requested-scope",
        "after-root-cause",
        "after-verification",
        "after-worktree-ready",
        "blocked",
        "findings",
        "plan",
        "present-options",
        "recommendation",
        "wait-for-answer"
      ]
    }
  }
}
